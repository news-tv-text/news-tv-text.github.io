# Пример /etc/news-tv/news-tv.env — то, что раньше лежало в GitHub Secrets.
# Скопировать на VPS:
#   sudo install -d -m 750 -o newstv -g newstv /etc/news-tv
#   sudo install -m 600 -o newstv -g newstv deploy/news-tv.env.example /etc/news-tv/news-tv.env
# и подставить реальные значения.

# Обязательный: ключ Openmodel (Anthropic-совместимый API).
OPENMODEL_API_KEY=

# Опционально, по умолчанию https://api.openmodel.ai/v1
#OPENMODEL_BASE_URL=

# Опционально, по умолчанию deepseek-v4-flash
#OPENMODEL_MODEL=

# Опционально: ключ gdelt_sk_... для платного GDELT Cloud.
# Без него источник просто пропускается.
#GDELT_CLOUD_API_KEY=
